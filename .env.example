# Export these in your shell, or copy this file to web/.env (Next.js and drizzle-kit both read it).
# Never commit real values.
# Pooled connection, used by the application.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Direct (unpooled) connection, used only for migrations (PG-003).
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST:5432/DATABASE
