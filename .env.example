# Export these in your shell, or copy this file to web/.env (Next.js and drizzle-kit both read it).
# Never commit real values.
# Pooled connection, used by the application.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Direct (unpooled) connection, used only for migrations (PG-003).
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Signs sessions and links. Make one with: openssl rand -hex 32
BETTER_AUTH_SECRET=<a long random value>
# The addresses XR Studio is served from, comma-separated, for example http://localhost:3000
APP_ORIGINS=<https://xr.example.com>
# The first people who can sign in on a new installation, comma-separated email addresses.
SIGN_IN_FIRST_ADDRESSES=<producer@example.com>
# Where emails are written in local work and tests; nothing is sent while this is the transport.
MAIL_CAPTURE_DIR=<a folder for captured emails>
# Passkeys: the domain they belong to, and the origins they are used from.
PASSKEY_RP_ID=<xr.example.com>
PASSKEY_ORIGINS=<https://xr.example.com>
