{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2023"],
    "allowJs": false,
    "incremental": true,
    // web/scripts run some modules in src/ with Node's type stripping, which needs the .ts extension.
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "app", "src", "test", "e2e", "*.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
