{
  "enabledPlugins": {
    "rfr-core@rules-for-robots": true,
    "rfr-process@rules-for-robots": true,
    "rfr-web@rules-for-robots": true,
    "rfr-unreal@rules-for-robots": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git fetch *)",
      "PowerShell(git fetch *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git switch *)",
      "PowerShell(git switch *)",
      "WebSearch",
      "Bash(npm ci)",
      "PowerShell(npm ci)",
      "Bash(npm test *)",
      "PowerShell(npm test *)",
      "Bash(npm run test *)",
      "PowerShell(npm run test *)",
      "Bash(npm run test:e2e *)",
      "PowerShell(npm run test:e2e *)",
      "Bash(npm run typecheck *)",
      "PowerShell(npm run typecheck *)",
      "Bash(npm run lint *)",
      "PowerShell(npm run lint *)",
      "Bash(npm run build *)",
      "PowerShell(npm run build *)",
      "Bash(npm run verify *)",
      "PowerShell(npm run verify *)",
      "Bash(npx playwright test *)",
      "PowerShell(npx playwright test *)",
      "Bash(npx vitest *)",
      "PowerShell(npx vitest *)",
      "Bash(npm run check *)",
      "PowerShell(npm run check *)",
      "Bash(./Scripts/Verify.ps1 *)",
      "PowerShell(./Scripts/Verify.ps1 *)",
      "Bash(pwsh ./Scripts/Verify.ps1 *)",
      "PowerShell(pwsh ./Scripts/Verify.ps1 *)",
      "Bash(pwsh -File ./Scripts/Verify.ps1 *)",
      "PowerShell(pwsh -File ./Scripts/Verify.ps1 *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "PowerShell(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push -f *)",
      "Bash(git push origin main)",
      "PowerShell(git push origin main)",
      "Bash(git push origin master)",
      "PowerShell(git push origin master)",
      "Bash(git push --delete *)",
      "PowerShell(git push --delete *)",
      "Bash(git push origin --delete *)",
      "PowerShell(git push origin --delete *)",
      "Bash(gh repo delete *)",
      "PowerShell(gh repo delete *)",
      "Bash(vercel --prod *)",
      "PowerShell(vercel --prod *)",
      "Bash(vercel deploy --prod *)",
      "PowerShell(vercel deploy --prod *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)"
    ]
  }
}
