{
  "name": "xr-studio-in-a-box",
  "private": true,
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "e2e": "pnpm -r --if-present run e2e",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run e2e"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
